# Environment variables for SafeClaim

# LLM Configuration (Open-weight model served via OpenAI-compatible endpoint)
# Option A: Groq Cloud (Recommended for cloud deployment and ultra-fast inference)
# Endpoint: https://api.groq.com/openai/v1 | Model: qwen-2.5-32b
# Provide your Groq API key (starts with gsk_...) below:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen-2.5-32b
LLM_API_KEY=your-groq-api-key-here

# Option B: Local Ollama (Local development with GPU/CPU)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# Retrieval & Grounding Thresholds
# If cosine similarity between question and top passage is below this, the system abstains.
# Raw TF-IDF cosine similarity cutoff for showing potentially relevant passages.
RETRIEVAL_SIMILARITY_THRESHOLD=0.11
RETRIEVAL_TOP_K=4

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for protected write and webhook endpoints. Generate unique secrets locally.
SAFECLAIM_ADMIN_TOKEN=replace-with-a-long-random-admin-token
SAFECLAIM_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
